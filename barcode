<!DOCTYPE html>
<html lang="mn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Олон Barcode Generator</title>

    <!-- JsBarcode -->
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 30px;
            background: #f5f5f5;
        }

        h1 {
            margin-bottom: 10px;
        }

        textarea {
            width: 100%;
            max-width: 700px;
            height: 180px;
            padding: 12px;
            font-size: 16px;
            box-sizing: border-box;
        }

        button {
            margin-top: 10px;
            padding: 10px 20px;
            font-size: 16px;
            cursor: pointer;
        }

        #barcodeContainer {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
            margin-top: 30px;
        }

        .barcode-item {
            background: white;
            padding: 20px;
            text-align: center;
            border: 1px solid #ddd;
            page-break-inside: avoid;
        }

        .barcode-number {
            margin-top: 8px;
            font-size: 16px;
            font-weight: bold;
        }

        @media print {
            body {
                background: white;
                margin: 10px;
            }

            textarea,
            button,
            h1,
            .description {
                display: none;
            }

            #barcodeContainer {
                margin-top: 0;
            }

            .barcode-item {
                border: none;
            }
        }
    </style>
</head>

<body>

<h1>Олон Barcode Generator</h1>

<p class="description">
    Barcode үүсгэх дугааруудыг нэг мөрөнд нэгээр оруулна уу.
</p>

<textarea id="trackingNumbers">DL000001041MN
DL000001042MN
DL000001043MN
DL000001044MN
DL000001045MN</textarea>

<br>

<button onclick="generateBarcodes()">Generate Barcode</button>
<button onclick="window.print()">Print</button>

<div id="barcodeContainer"></div>

<script>
function generateBarcodes() {

    const input = document.getElementById("trackingNumbers").value;

    const numbers = input
        .split(/\r?\n/)
        .map(x => x.trim())
        .filter(x => x !== "");

    const container = document.getElementById("barcodeContainer");

    container.innerHTML = "";

    numbers.forEach((number, index) => {

        const item = document.createElement("div");
        item.className = "barcode-item";

        const svg = document.createElementNS(
            "http://www.w3.org/2000/svg",
            "svg"
        );

        svg.id = "barcode-" + index;

        const text = document.createElement("div");
        text.className = "barcode-number";
        text.textContent = number;

        item.appendChild(svg);
        item.appendChild(text);

        container.appendChild(item);

        JsBarcode(svg, number, {
            format: "CODE128",
            width: 2,
            height: 80,
            displayValue: true,
            fontSize: 16,
            margin: 10
        });
    });
}

// Page нээгдэхэд автоматаар үүсгэнэ
generateBarcodes();
</script>

</body>
</html>
